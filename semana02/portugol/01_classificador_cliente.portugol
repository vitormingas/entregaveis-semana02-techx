// Desafio 1 - Classificador de Cliente (versao em Portugol)

programa
{
	funcao inicio()
	{
		inteiro idade_cliente
		real    renda_cliente
		cadeia  categoria

		escreva("Digite a idade do cliente: ")
		leia(idade_cliente)

		escreva("Digite a renda mensal do cliente: R$ ")
		leia(renda_cliente)

		se (renda_cliente >= 10000 e idade_cliente >= 25) {
			categoria <- "Diamante"
		} senao se (renda_cliente >= 5000) {
			categoria <- "Ouro"
		} senao se (renda_cliente >= 2000) {
			categoria <- "Prata"
		} senao {
			categoria <- "Bronze"
		}

		escreval("Cliente com ", idade_cliente, " anos e renda de R$ ", renda_cliente, " classificado como: ", categoria)
	}
}
